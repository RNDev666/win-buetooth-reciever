#include "winres.h"

// Application icon
// IDI_ICON1 ICON "app.ico"

// Version information
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bluetooth Audio Receiver"
            VALUE "FileDescription", "Bluetooth Audio Receiver Application"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "BluetoothAudioReceiver"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "BluetoothAudioReceiver.exe"
            VALUE "ProductName", "Bluetooth Audio Receiver"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END 
